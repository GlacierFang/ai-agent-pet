# ---- 目标 ----
CONFIG_IDF_TARGET="esp32s3"

# ---- Flash：N8R8 = 8MB flash ----
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
# 用 DIO 而不是 QIO：ESP32-S3 上 Octal(OPI) PSRAM 与 flash 共用 SPI0，
# flash 跑 QIO 会和 OPI 冲突，表现为板子起不来。
# 🟡 本条是经验结论，未从 IDF v5.5 源码逐行核实 —— 上机若起不来，先改这里。
# DIO 对 Quad PSRAM 同样安全，所以这是保守选择。
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- PSRAM：N8R8 = 8MB OPI（八线 Octal）----
# 必须是 OCT：默认是 QUAD，配错固件静默地找不到 PSRAM。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ---- 分区表 ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---- mDNS：设备要把 petd.local 解析成 IP ----
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000

# ---- 编译器 ----
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# ---- CPU ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# ---- 看门狗 ----
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# ---- 日志 ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- 主任务栈 ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
