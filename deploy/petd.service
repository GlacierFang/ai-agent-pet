[Unit]
Description=petd — AI agent 桌面宠物服务端
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ai-agent-pet
ExecStart=%h/ai-agent-pet/.venv/bin/python -m petd --host 0.0.0.0 --port 18860
Restart=on-failure
RestartSec=5
# 后台页开着 SSE 长连接，优雅关闭可能等不到头；到点就强杀，别让 restart 卡死
TimeoutStopSec=15

# 凭据用 EnvironmentFile 而不是 Environment —— 后者会出现在 ps 输出里
EnvironmentFile=-%h/.config/petd/petd.env

# 收紧权限：设备与服务都不需要额外能力
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/ai-agent-pet/petd/data
# 注意：不要加 AF_NETLINK —— 配合 PrivateTmp 会触发 systemd 的
# NAMESPACE 限制，服务直接起不来（status=226/NAMESPACE）。
# mDNS 枚举网卡地址改用 SIOCGIFCONF ioctl（纯 ioctl，不需要 netlink），
# 见 petd/mdns.py 的 _addresses_via_ifconf()。
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
