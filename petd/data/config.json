{
  "gateway": {
    "url": "ws://127.0.0.1:18789",
    "token": "",
    "clientId": "gateway-client",
    "clientMode": "backend",
    "role": "operator",
    "scopes": [
      "operator.read"
    ],
    "subscribeLimit": 30,
    "useProxy": false
  },
  "server": {
    "host": "0.0.0.0",
    "port": 18860,
    "allowPublic": false
  },
  "render": {
    "width": 240,
    "height": 320,
    "quality": 85,
    "subsampling": 2
  },
  "frame": {
    "idleFps": 1,
    "activeFps": 10,
    "maxInFlight": 2
  },
  "ui": {
    "skin": "柴犬麦兜",
    "density": 1,
    "features": [
      "clock",
      "device",
      "notify",
      "recent_done",
      "sessions",
      "weather"
    ],
    "cardDwellSec": 8,
    "messageHoldSec": 3,
    "sleepStart": "22:00",
    "sleepEnd": "06:30",
    "sleepEnabled": true,
    "weatherCity": ""
  },
  "mdns": {
    "enabled": true,
    "hostname": "petd.local"
  }
}