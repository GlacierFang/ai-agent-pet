{
  "_comment": "会话状态判定规则 —— 随版本走的产品逻辑，不是用户数据。",
  "version": 2,
  "priority": [
    "error",
    "waiting",
    "working",
    "done",
    "idle"
  ],
  "stability": {
    "idleAfterMs": 3000,
    "idleGraceMs": 30000,
    "eventDebounceMs": 200,
    "doneDecayMs": 180000
  },
  "screen": {
    "busyStates": ["working", "waiting", "error"]
  },
  "exclude": {
    "isBackground": true
  },
  "rules": {
    "error": {
      "all": [
        {
          "status": "error"
        }
      ]
    },
    "waiting": {
      "any": [
        {
          "permissionModePending": true
        },
        {
          "unread": true
        }
      ]
    },
    "working": {
      "all": [
        {
          "status": "running"
        },
        {
          "hasActiveRun": true
        }
      ]
    },
    "done": {
      "all": [
        {
          "status": "done"
        }
      ]
    },
    "idle": {
      "none": [
        {
          "status": "running"
        },
        {
          "hasActiveRun": true
        }
      ]
    }
  }
}
