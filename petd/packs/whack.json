{
  "id": "whack",
  "version": 1,
  "order": 40,
  "title": "打地鼠",
  "hint": "旋转选格 · 短按敲击",
  "requires": [
    "cell",
    "grid",
    "timer",
    "score",
    "move_cell",
    "intent_overlap",
    "wrap",
    "outline"
  ],
  "grid": {
    "cols": 6,
    "rows": 1,
    "cell": 40,
    "x": 0,
    "y": 132,
    "cellW": 40,
    "cellH": 56,
    "wrap": true,
    "border": true,
    "borderColor": "#5C4033"
  },
  "intents": [
    {
      "name": "rotate",
      "target": "cursor"
    },
    {
      "name": "strike",
      "target": "cursor"
    }
  ],
  "input": {
    "rot": {
      "intent": "rotate"
    },
    "press": {
      "intent": "strike"
    }
  },
  "entities": [
    {
      "id": "cursor",
      "shape": "cell",
      "gx": 0,
      "gy": 0,
      "color": "#FFFFFF",
      "outline": true
    },
    {
      "id": "mole",
      "shape": "cell",
      "gx": 3,
      "gy": 0,
      "color": "#C80000"
    }
  ],
  "timers": [
    {
      "intervalMs": 1800,
      "repeat": true
    }
  ],
  "rules": [
    {
      "on": "start",
      "effects": [
        {
          "fx": "hide",
          "target": "mole"
        },
        {
          "fx": "start_timer",
          "value": 0
        }
      ]
    },
    {
      "on": "timer",
      "timer": 0,
      "effects": [
        {
          "fx": "advance_cell",
          "target": "mole",
          "value": 1
        }
      ]
    },
    {
      "on": "intent",
      "intent": "rotate",
      "target": "cursor",
      "effects": [
        {
          "fx": "move_cell",
          "target": "cursor",
          "value": 1,
          "value2": 0
        }
      ]
    },
    {
      "on": "intent_overlap",
      "intent": "strike",
      "target": "cursor",
      "other": "mole",
      "effects": [
        {
          "fx": "add_score",
          "value": 10
        },
        {
          "fx": "hide",
          "target": "mole"
        }
      ]
    }
  ],
